{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daemon-Core Profile",
  "type": "object",
  "required": [
    "name",
    "theme",
    "modules"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "developerMode": {
      "type": "boolean"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
``
