{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daemon-Core Profile",
  "type": "object",
  "required": ["name", "theme", "modules"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "developerMode": {
      "type": "boolean"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
