{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daemon-Core Config",
  "type": "object",
  "required": ["version", "profile", "theme", "locale"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}_[A-Z]{2}$"
    }
  },
  "additionalProperties": false
}
